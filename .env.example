# Salin ke .env lewat `npm run setup` (rahasia diisi otomatis), lalu isi bagian Model AI.

# --- Model AI ---------------------------------------------------------------
# Format API penyedia model:
#   anthropic  API Claude resmi, atau server lain yang meniru Messages API
#   openai     OpenAI, OpenRouter, Groq, DeepSeek, Gemini, Ollama, 9router, dan server lain yang meniru Chat Completions
# Kosong berarti anthropic.
LLM_PROVIDER=
# Kosongkan untuk alamat resmi penyedia (api.anthropic.com atau api.openai.com).
LLM_BASE_URL=
LLM_API_KEY=
# Kosong berarti claude-opus-5-5 (khusus format anthropic). Format openai wajib diisi.
LLM_MODEL=
# Opsional. Untuk API Claude resmi bawaannya "low", yang paling cepat dan cukup untuk layanan pelanggan.
# Untuk server lain hanya dikirim bila diisi (sebagai reasoning_effort di format openai).
LLM_EFFORT=
# Opsional. Batas panjang jawaban dalam token, bila penyedia menolak bawaannya.
LLM_MAX_TOKENS=

# Contoh pengisian (salin ke atas, satu saja):
#
# API Claude resmi (kunci dari https://platform.claude.com):
#   LLM_PROVIDER=anthropic
#   LLM_API_KEY=sk-ant-...
#
# 9router di komputer sendiri (nama model ada di dashboard 9router, http://localhost:20128/dashboard):
#   LLM_PROVIDER=openai
#   LLM_BASE_URL=http://localhost:20128/v1
#   LLM_API_KEY=kunci-dari-dashboard-9router   (boleh kosong bila 9router tidak meminta kunci)
#   LLM_MODEL=cc/claude-sonnet-5-5
#
# OpenAI:      LLM_PROVIDER=openai   LLM_MODEL=gpt-5.5   LLM_API_KEY=sk-...
# OpenRouter:  LLM_PROVIDER=openai   LLM_BASE_URL=https://openrouter.ai/api/v1   LLM_MODEL=anthropic/claude-sonnet-5.5
# Groq:        LLM_PROVIDER=openai   LLM_BASE_URL=https://api.groq.com/openai/v1
# DeepSeek:    LLM_PROVIDER=openai   LLM_BASE_URL=https://api.deepseek.com/v1   LLM_MODEL=deepseek-chat
# Gemini:      LLM_PROVIDER=openai   LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# Ollama:      LLM_PROVIDER=openai   LLM_BASE_URL=http://localhost:11434/v1   LLM_API_KEY=   (tanpa kunci)

# --- Server -----------------------------------------------------------------
PORT=3000
# Alamat publik server. Dipakai di potongan kode widget yang ditempel ke website klien.
PUBLIC_URL=http://localhost:3000

# --- Dashboard --------------------------------------------------------------
ADMIN_PASSWORD=
SESSION_SECRET=

# --- Database (PostgreSQL + pgvector) ---------------------------------------
POSTGRES_PASSWORD=
DB_PORT=5432
DATABASE_URL=

# Kunci untuk mengenkripsi token Telegram/Discord yang disimpan di database.
ENCRYPTION_KEY=
