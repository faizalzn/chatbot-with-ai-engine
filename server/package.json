{
  "name": "@sahut/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false --include ../.env src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "seed": "tsx src/scripts/seed.ts",
    "ingest": "tsx src/scripts/ingest.ts",
    "search": "tsx src/scripts/search.ts",
    "check:search": "tsx src/scripts/check-search.ts",
    "check:llm": "tsx src/scripts/check-llm.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "@hono/node-server": "^2.1.8",
    "@huggingface/transformers": "^4.3.2",
    "baileys": "^7.0.0-rc14",
    "discord.js": "^14.28.1",
    "drizzle-orm": "^0.45.4",
    "grammy": "^1.46.0",
    "hono": "^4.13.18",
    "mammoth": "^1.13.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "qrcode": "^1.5.4",
    "unpdf": "^2.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
